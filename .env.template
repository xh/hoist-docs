# Duplicate this file in your local repo with filename `.env`. It will be ignored by git, but loaded
# by Gradle via a dotenv Gradle plugin and passed to the app to use as instance configs.
# Any uncommented vars in this file *must* be set in a local .env file.

# Required variables - must be set in .env, build will throw if missing.
APP_HOISTDOCS_ENVIRONMENT=Development

# Database - set USE_H2=true for a throwaway in-memory database (local dev, minimal installs).
#APP_HOISTDOCS_USE_H2=true
#APP_HOISTDOCS_DB_HOST=localhost
#APP_HOISTDOCS_DB_SCHEMA=hoistdocs
#APP_HOISTDOCS_DB_USER=hoistdocs
#APP_HOISTDOCS_DB_PASSWORD=hoistdocs
#APP_HOISTDOCS_DB_CREATE=update

# Directory holding index files (`react-<version>.json[.gz]`, `core-<version>.json[.gz]`).
# Default: ./indexes relative to the working directory.
#APP_HOISTDOCS_INDEX_DIR=

# OAuth provider for the docs viewer and admin console - AUTH_ZERO (default) or NONE (local
# username/password login). The /mcp endpoint is open to anonymous callers in every mode.
#APP_HOISTDOCS_OAUTH_PROVIDER=AUTH_ZERO

# Bootstrap admin. _USER alone grants an OAuth-sourced user admin rights in local development.
# With _PASSWORD too, a password-enabled local user is created - pair with OAUTH_PROVIDER=NONE.
#APP_HOISTDOCS_BOOTSTRAP_ADMIN_USER=
#APP_HOISTDOCS_BOOTSTRAP_ADMIN_PASSWORD=
