{
    "arrowParens": "avoid",
    "bracketSpacing": false,
    "printWidth": 100,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "none",
    "overrides": [
        {
            "files": ["*.json", "*.md"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
