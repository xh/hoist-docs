{
  "name": "@xh/hoist-docs",
  "version": "1.0.0-SNAPSHOT",
  "description": "Hoist documentation and API reference for AI coding agents, over MCP",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xh/hoist-docs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "hoist-docs": "bin/hoist-docs.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "default": "./dist/docs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "start": "node src/cli.ts --http",
    "dev": "node --watch src/cli.ts --http",
    "mcp": "node src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "build:react": "node builders/react/cli/build-index.ts",
    "build:core": "builders/core/build-index.sh",
    "pack:index": "node scripts/pack-index.ts",
    "publish:indexes": "node scripts/publish-indexes.ts",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.10.0",
    "@xh/eslint-config": "^8.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.7.0"
}
